  "scripts": {
    "prestart": "npm run generate-auto-module-bindings",
    "start": "vite",
    "prebuild": "npm run generate-auto-module-bindings",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "cache-clean": "rm -rf node_modules/.cache && rm .eslintcache",
    "prettier": "pretty-quick --staged --pattern '**/*.*(ts|tsx)'",
    "precommit": "lint-staged",
    "scripts:compile": "tsc -p scripts/ts/scripts-tsconfig.json",
    "scripts:document": "node scripts/ts/document-entities.js",
    "document": "npm run scripts:compile && npm run scripts:document",
    "generate-level": "npm run scripts:compile && node scripts/ts/generate-level.js",
    "generate-spell-apis": "npm run scripts:compile && node scripts/ts/generate-spell-api-manifest.js",
    "generate-builtin-script-metadata": "npm run scripts:compile && node scripts/ts/generate-builtin-script-metadata.js",
    "generate-auto-module-bindings": "npm run scripts:compile && node scripts/ts/generate-auto-module-bindings.js",
    "trace-spine-regions": "npm run scripts:compile && node scripts/ts/trace-spine-regions.js",
    "tileset-editor": "npm run scripts:compile && node scripts/ts/tileset-editor.js",
    "screenshot-levels": "npm run scripts:compile && node scripts/ts/screenshot-levels.js"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "git add"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "@typescript-eslint/no-unused-vars": [
        "warn",
        {
          "args": "none",
          "varsIgnorePattern": "^_"
        }
      ],
      "import/no-webpack-loader-syntax": "off"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "roots": [
      "<rootDir>/src"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "setupFiles": [],
    "globalSetup": "jest-environment-puppeteer/setup",
    "globalTeardown": "jest-environment-puppeteer/teardown",
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.ts"
    ],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.{js,jsx,ts,tsx}",
      "<rootDir>/src/**/*.{spec,test}.{js,jsx,ts,tsx}"
    ],
    "testPathIgnorePatterns": [
      "\\.harness\\.(ts|tsx|js|jsx)$"
    ],
    "testEnvironment": "node",
    "transform": {
      "^.+.(txt|tmj|tsj|glsl|frag|vert|less|raw\\.js|png|jpg|mp3|wav|opus|ogg|fnt|glb|prs|prsg|md|atlas|skel|ttf)$": "<rootDir>/config/jest/fileTransform.js",
      "^.+.(js|jsx|mjs|cjs|ts|tsx)$": [
        "babel-jest",
        {
          "configFile": "./config/jest/babelJest.config.js"
        }
      ],
      "^.+.css$": "<rootDir>/config/jest/cssTransform.js"
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\](.+)(?!offset-polygon)\\?.(js|jsx|mjs|cjs|ts|tsx)$",
      "^.+\\.module\\.(css|sass|scss|less)$"
    ],
    "moduleDirectories": [
      "node_modules",
      "<rootDir>"
    ],
    "modulePaths": [],
    "moduleNameMapper": {
      "^react-native$": "react-native-web",
      "^react-dnd$": "identity-obj-proxy",
      "^three$": "three",
      "^three-bmfont-text$": "identity-obj-proxy",
      "^src/vendor/load-bmfont-browser$": "identity-obj-proxy",
      "^.+\\.module\\.(css|sass|scss)$": "identity-obj-proxy",
      "src/scripting/transpiler/index.ts": "identity-obj-proxy",
      "file-loader?.+": "identity-obj-proxy",
      "^.+.(ttf|ogg)$": "identity-obj-proxy",
      "^acorn$": "acorn",
      "^@babel/standalone$": "@babel/core",
      "^harfbuzzjs$": "<rootDir>/config/jest/harfbuzzMock.js",
      "autoPseudoModules$": "<rootDir>/config/jest/autoPseudoModulesMock.js"
    },
    "moduleFileExtensions": [
      "web.js",
      "js",
      "web.ts",
      "ts",
      "web.tsx",
      "tsx",
      "json",
      "web.jsx",
      "jsx",
      "node"
    ],
    "watchPlugins": [
      "jest-watch-typeahead/filename",
      "jest-watch-typeahead/testname"
    ],
    "resetMocks": true
  },
  "babel": {
    "presets": [
      [
        "react-app",
        {
          "typescript": true
        }
      ]
    ]
  },
